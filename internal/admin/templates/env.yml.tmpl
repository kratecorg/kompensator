# {{.Name}} environment: a deployment target.
#
# Place a stack in it with:
#   kompensator env stack add {{.Name}} <stack> [--node <node>]
#
# Which nodes exist and how to reach them is inventory/nodes.yml; an environment
# runs on every node in the inventory unless a stack below pins itself to a
# subset. ${ENV_NAME} resolves to this environment's name in every compose file
# deployed here, so several environments can share a node without colliding.
name: {{.Name}}

# Variable overrides for this environment. They win over the stack defaults and
# lose against the kompensator built-ins (NODE_NAME, ENV_NAME, <SERVICE>_IMAGE
# and _TAG). Secrets do NOT belong here — see 'kompensator secrets set'.
variables:
{{- if .Variables}}
{{- range .Variables}}
  {{.Key}}: {{.Value}}
{{- end}}
{{- else}} {}
{{- end}}

# Stacks deployed in this environment, appended by 'kompensator env stack add'.
# An entry is either a bare stack name (runs on every node) or a mapping with a
# "nodes" pin.
stacks:
